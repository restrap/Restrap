<odoo>
    <!-- Inherit Form View to Modify it -->
    <record id="res_config_settings_view_form_hdk_website_base" model="ir.ui.view">
        <field name="name">res.config.settings.sale.hdk_website_base</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='website']" position="inside">
                <block title="Hamdek Website Configuration" name="module_hdk_website_base">

                </block>
            </xpath>
        </field>
    </record>
</odoo>